{
  "name": "chrome-mcp-bridge",
  "version": "1.6.0",
  "description": "Drive your already-logged-in Chrome from any MCP client, through a Chrome extension and chrome.debugger.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "chrome-mcp-bridge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "dev": "tsup src/index.ts --format esm --watch"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chrome-extension",
    "browser-automation",
    "chrome-debugger",
    "cdp"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.4.0",
    "typescript": "^5.6.2"
  }
}
